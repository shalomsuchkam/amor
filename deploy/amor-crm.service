[Unit]
Description=Amor Flowers CRM
After=network.target

[Service]
User=www-data
WorkingDirectory=/opt/amor-crm
# Секреты (CRM_SECRET_KEY и т.д.) лежат в общем файле с правами 640, не в коде.
EnvironmentFile=/etc/amor-flowers.env
ExecStart=/opt/amor-crm/venv/bin/gunicorn -w 2 -b 127.0.0.1:8002 wsgi:app
Restart=always

[Install]
WantedBy=multi-user.target
